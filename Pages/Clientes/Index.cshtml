@page "/Clientes"
@model BlakBox.Api.Pages.Clientes.IndexModel

@{
    ViewData["Title"] = "Clientes";
}

<link rel="stylesheet" href="~/css/clientes.css" asp-append-version="true" />

<div class="clientes">

    <div class="container">

        <div class="header">
            <h2>Clientes</h2>

            <div class="subtitle">
                Gerencie os clientes que possuem instalações
                dos sistemas licenciados.
            </div>
        </div>

        @if (TempData["Sucesso"] != null)
        {
            <div class="alert alert-success">
                @TempData["Sucesso"]
            </div>
        }

        @if (TempData["Erro"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Erro"]
            </div>
        }

        <!-- =========================================================
             NOVO CLIENTE
             ========================================================= -->

        <div class="card">

            <div class="card-header">
                <h3>Novo cliente</h3>
            </div>

            <div class="card-body">

                <form method="post"
                      action="/Clientes?handler=Criar">

                    @Html.AntiForgeryToken()

                    <div class="form-grid">

                        <div class="campo">

                            <label for="nome">
                                Nome
                            </label>

                            <input type="text"
                                   id="nome"
                                   name="nome"
                                   class="form-control"
                                   maxlength="150"
                                   placeholder="Nome do cliente"
                                   required />

                        </div>

                        <div class="campo">

                            <label for="documento">
                                Documento
                            </label>

                            <input type="text"
                                   id="documento"
                                   name="documento"
                                   class="form-control"
                                   maxlength="30"
                                   placeholder="CPF, CNPJ ou outro" />

                        </div>

                        <div class="campo">

                            <label for="email">
                                E-mail
                            </label>

                            <input type="email"
                                   id="email"
                                   name="email"
                                   class="form-control"
                                   maxlength="150"
                                   placeholder="cliente@exemplo.com" />

                        </div>

                        <div class="campo">

                            <label for="telefone">
                                Telefone
                            </label>

                            <input type="text"
                                   id="telefone"
                                   name="telefone"
                                   class="form-control"
                                   maxlength="30"
                                   placeholder="Telefone" />

                        </div>

                        <div class="campo">

                            <label for="endereco">
                                Endereço
                            </label>

                            <input type="text"
                                   id="endereco"
                                   name="endereco"
                                   class="form-control"
                                   maxlength="300"
                                   placeholder="Rua, avenida..." />

                        </div>

                        <div class="campo">

                            <label for="numero">
                                Número
                            </label>

                            <input type="text"
                                   id="numero"
                                   name="numero"
                                   class="form-control"
                                   maxlength="20"
                                   placeholder="Número" />

                        </div>

                        <div>

                            <button type="submit"
                                    class="btn btn-primary">

                                Cadastrar

                            </button>

                        </div>

                    </div>

                </form>

            </div>

        </div>

        <!-- =========================================================
             CLIENTES CADASTRADOS
             ========================================================= -->

        <div class="card">

            <div class="card-header">

                <h3>Clientes cadastrados</h3>

                <div class="contador">
                    @Model.Clientes.Count cliente(s)
                </div>

            </div>

            @if (Model.Clientes.Count == 0)
            {
                <div class="sem-dados">
                    Nenhum cliente cadastrado.
                </div>
            }
            else
            {
                <div class="table-container">

                    @foreach (var cliente in Model.Clientes)
                    {
                        <form id="form-status-@cliente.ClienteId" method="post" action="/Clientes?handler=Status">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="clienteId" value="@cliente.ClienteId" />
                            <input type="hidden" name="ativo" value="@(cliente.Ativo ? "false" : "true")" />
                        </form>
                    }

                    <table>

                        <thead>

                            <tr>

                                <th>
                                    Nome
                                </th>

                                <th>
                                    Documento
                                </th>

                                <th>
                                    E-mail
                                </th>

                                <th>
                                    Telefone
                                </th>

                                <th>
                                    Endereço
                                </th>

                                <th>
                                    Número
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Instalações
                                </th>

                                <th>
                                    Criado em
                                </th>

                                <th>
                                    Ações
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var cliente in Model.Clientes)
                            {
                                <tr>

                                    <td>

                                        <form id="form-salvar-@cliente.ClienteId"
                                              method="post"
                                              action="/Clientes?handler=Salvar">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="clienteId"
                                                   value="@cliente.ClienteId" />

                                        </form>

                                        <input type="text"
                                               name="nome"
                                               value="@cliente.Nome"
                                               class="form-control"
                                               maxlength="150"
                                               required
                                               form="form-salvar-@cliente.ClienteId" />

                                    </td>

                                    <td>

                                        <input type="text"
                                               name="documento"
                                               value="@cliente.Documento"
                                               class="form-control"
                                               maxlength="30"
                                               form="form-salvar-@cliente.ClienteId" />

                                    </td>

                                    <td>

                                        <input type="email"
                                               name="email"
                                               value="@cliente.Email"
                                               class="form-control"
                                               maxlength="150"
                                               form="form-salvar-@cliente.ClienteId" />

                                    </td>

                                    <td>

                                        <input type="text"
                                               name="telefone"
                                               value="@cliente.Telefone"
                                               class="form-control"
                                               maxlength="30"
                                               form="form-salvar-@cliente.ClienteId" />

                                    </td>

                                    <td>

                                        <input type="text"
                                               name="endereco"
                                               value="@cliente.Endereco"
                                               class="form-control"
                                               maxlength="300"
                                               form="form-salvar-@cliente.ClienteId" />

                                    </td>

                                    <td>

                                        <input type="text"
                                               name="numero"
                                               value="@cliente.Numero"
                                               class="form-control"
                                               maxlength="20"
                                               form="form-salvar-@cliente.ClienteId" />

                                    </td>

                                    <td>

                                        @if (cliente.Ativo)
                                        {
                                            <span class="status-badge status-ativo">
                                                ATIVO
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-inativo">
                                                INATIVO
                                            </span>
                                        }

                                    </td>

                                    <td class="numero">

                                        <span class="texto-destaque">
                                            @cliente.Instalacoes.Count
                                        </span>

                                    </td>

                                    <td>

                                        @cliente.CriadoEm.ToString(
                                            "dd/MM/yyyy HH:mm")

                                    </td>

                                    <td class="acoes">

                                        <button type="submit"
                                                class="btn btn-primary"
                                                form="form-salvar-@cliente.ClienteId">

                                            Salvar

                                        </button>

                                            @if (cliente.Ativo)
                                            {
                                                <button type="submit"
                                                        class="btn btn-danger"
                                                        form="form-status-@cliente.ClienteId"
                                                        onclick="return confirm('Inativar este cliente? As instalações continuarão cadastradas, mas o cliente ficará inativo.');">

                                                    Inativar

                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        class="btn btn-success"
                                                        form="form-status-@cliente.ClienteId"
                                                        onclick="return confirm('Ativar este cliente?');">

                                                    Ativar

                                                </button>
                                            }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>
