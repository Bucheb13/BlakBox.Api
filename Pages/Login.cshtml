@page "/Login"
@model BlakBox.Api.Pages.LoginModel
@{
    Layout = null;
    var returnUrl = Request.Query["ReturnUrl"].ToString();
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Entrar - BlakBox</title>
    <style>
        body{margin:0;min-height:100vh;display:grid;place-items:center;background:#0b1220;color:#e8eef8;font:16px system-ui,sans-serif}
        main{width:min(380px,calc(100% - 40px));padding:32px;border:1px solid #263449;border-radius:16px;background:#111c2d}
        h1{margin-top:0}label{display:block;margin:18px 0 6px}input{box-sizing:border-box;width:100%;padding:12px;border:1px solid #40516a;border-radius:8px;background:#08111e;color:#fff}
        button{width:100%;margin-top:24px;padding:12px;border:0;border-radius:8px;background:#2bc5b4;color:#06111b;font-weight:700;cursor:pointer}.erro{color:#ff9a9a}
    </style>
</head>
<body>
<main>
    <h1>BlakBox</h1>
    <p>Entre na Central de Licenciamento.</p>
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <p class="erro" role="alert">@Model.ErrorMessage</p>
    }
    @if (Model.ConfiguracaoDisponivel)
    {
        <form method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <label for="username">Usuário</label>
            <input id="username" name="Username" autocomplete="username" required maxlength="100" />
            <label for="password">Senha</label>
            <input id="password" name="Password" type="password" autocomplete="current-password" required />
            <button type="submit">Entrar</button>
        </form>
    }
</main>
</body>
</html>
